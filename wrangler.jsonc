{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fertec",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "fer.tec.br/*",
      "zone_name": "fer.tec.br"
    }
  ]
}
