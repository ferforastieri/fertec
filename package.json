{
  "name": "fertec-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_PUBLIC_SITE_URL=https://fer.tec.br next build && node scripts/prepare-export.mjs",
